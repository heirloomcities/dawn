{{ 'section-hero-video.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign poster = section.settings.cover_image
  if poster == null and section.settings.video != null
    assign poster = section.settings.video.preview_image
  endif

  assign height_class = ''
  case section.settings.section_height
    when 'small'
      assign height_class = 'hero-video--small'
    when 'medium'
      assign height_class = 'hero-video--medium'
    when 'large'
      assign height_class = 'hero-video--large'
    when 'full'
      assign height_class = 'hero-video--full'
  endcase
-%}

<section class="hero-video color-{{ section.settings.color_scheme }} gradient {{ height_class }}">
  <div class="hero-video__media" {% if poster != null %}style="--hero-video-poster:url({{ poster | image_url: width: 2400 }});"{% endif %}>
    {%- if section.settings.video != null -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true
      }}
    {%- elsif poster != null -%}
      {{
        poster
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          sizes: '100vw',
          widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          class: 'hero-video__fallback-image',
          alt: section.settings.heading | escape
      }}
    {%- else -%}
      {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg hero-video__placeholder' }}
    {%- endif -%}

    <div class="hero-video__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

    {%- if section.blocks.size > 0 -%}
      <div class="hero-video__content page-width">
        <div class="hero-video__content-inner hero-video__content-inner--{{ section.settings.content_position }} hero-video__content-inner--align-{{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2 class="hero-video__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{ block.settings.heading }}
                </h2>
              {%- when 'text' -%}
                <div class="hero-video__text rte" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- when 'buttons' -%}
                <div class="hero-video__buttons" {{ block.shopify_attributes }}>
                  {%- if block.settings.button_label_1 != blank -%}
                    <a
                      class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                      {% if block.settings.button_link_1 != blank %}href="{{ block.settings.button_link_1 }}"{% endif %}
                    >
                      {{ block.settings.button_label_1 | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                      {% if block.settings.button_link_2 != blank %}href="{{ block.settings.button_link_2 }}"{% endif %}
                    >
                      {{ block.settings.button_label_2 | escape }}
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback image (optional)"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "default": "large",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colors",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "New book launching April 20.04.2026"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h0",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a short message here.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Button 1 label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Button 1 link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "label": "Button 1 secondary style",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button 2 link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "label": "Button 2 secondary style",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero video",
      "blocks": [
        { "type": "heading" }
      ]
    }
  ]
}
{% endschema %}

